# Copy this file to .env and fill in the values. .env is git-ignored; never commit real secrets.

# Signs login sessions, form CSRF tokens and password-reset links. Use a long random string:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Outgoing email for password-reset links (Gmail shown). MAIL_PASSWORD is a
# Gmail *App Password* (https://myaccount.google.com/apppasswords), not your
# normal Gmail password. If any of MAIL_SERVER / MAIL_USERNAME / MAIL_PASSWORD
# is empty, the app runs in dev mode and shows reset links on screen instead.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=
MAIL_SENDER=Lore <you@gmail.com>
